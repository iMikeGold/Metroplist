{
  "name": "metroplist-app-site",
  "version": "0.1.0",
  "private": true,
  "description": "Metroplist Data Foundation and Density Explorer — Release 0.1",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "foundation:verify": "node scripts/verify-foundation.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run foundation:verify",
    "db:migrate:local": "wrangler d1 migrations apply metroplist-app-local --local",
    "db:seed:local": "wrangler d1 execute metroplist-app-local --local --file=database/seeds/0001_reference_data.sql",
    "db:seed:evidence:local": "wrangler d1 execute metroplist-app-local --local --file=database/seeds/0002_greenwich_bromley_density_2021.sql",
    "db:migrate:remote": "wrangler d1 migrations apply metroplist-data --remote",
    "db:seed:reference:remote": "wrangler d1 execute metroplist-data --remote --file=database/seeds/0001_reference_data.sql",
    "db:seed:evidence:remote": "wrangler d1 execute metroplist-data --remote --file=database/seeds/0002_greenwich_bromley_density_2021.sql",
    "db:seed:map:remote": "wrangler d1 execute metroplist-data --remote --file=database/seeds/0003_map_manifest.sql",
    "db:verify:remote": "wrangler d1 execute metroplist-data --remote --command=\"SELECT (SELECT COUNT(*) FROM places) AS places, (SELECT COUNT(*) FROM observations) AS observations, (SELECT COUNT(*) FROM calculations) AS calculations, (SELECT COUNT(*) FROM observation_lineage) AS lineage;\"",
    "db:export:remote": "wrangler d1 export metroplist-data --remote --output=data/exports/metroplist-data.sql",
    "ingest:world:acquire": "python3 scripts/ingest/acquire-world-data.py --acquire",
    "ingest:world:generate": "python3 scripts/ingest/acquire-world-data.py",
    "ingest:world:remote": "wrangler d1 execute metroplist-data --remote --file=database/generated/0003_world_registry.sql",
    "ingest:uk:acquire": "python3 scripts/ingest/acquire-uk-places.py --acquire",
    "ingest:uk:generate": "python3 scripts/ingest/acquire-uk-places.py",
    "ingest:uk:remote": "wrangler d1 execute metroplist-data --remote --file=database/generated/0004_uk_places.sql",
    "catalogue:ons": "node scripts/ingest/catalogue-ons.mjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts --include-runtime false"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "maplibre-gl": "5.24.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "typescript": "^5",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  }
}
