{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "metroplist-app",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "metroplist-app"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "metroplist-data-v3",
      "database_id": "831a0c7a-62c3-46b7-986d-3a9eb5428aa4",
      "migrations_dir": "database/migrations"
    },
    {
      "binding": "CITY_HISTORY_ESTIMATES",
      "database_name": "metroplist-city-history-estimates",
      "database_id": "49ec20c2-8e0e-4fe3-8c3a-35ba3dd8bed0"
    },
    {
      "binding": "CITY_HISTORY_PROJECTIONS",
      "database_name": "metroplist-city-history-projections",
      "database_id": "3f2c5236-e089-4bc4-9a83-73bb0d9d1d8d"
    },
    {
      "binding": "PUBLICATIONS_DB",
      "database_name": "metroplist-publications",
      "database_id": "8cad5b1c-148c-4da4-a19f-40489f826301"
    }
  ]
}
