{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "metroplist-app",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "metroplist-app"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "metroplist-data-v2",
      "database_id": "443d7d74-a820-4f5d-a4f4-493bb88b5cfa",
      "migrations_dir": "database/migrations"
    }
  ]
}
